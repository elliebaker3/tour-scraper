      "eventName": "update",
      "eventId": "77",
      "data": "{\"bind\":\"publication_en-2026-17\",\"app\":\"vue\",\"origin\":\"news-2026-17\",\"change\":\"added\",\"id\":\"3a4591ecfb5af72c33a1341194f097e729ec24ce02e83c2a6a2b5667422b9744\",\"data\":{\"stageType\":\"PLN\",\"locale\":\"en\",\"pinned\":false,\"type\":\"liv\",\"title\":\"Welcome to the live coverage of stage 17 of La Vuelta 26\",\"createdAt\":\"2026-09-09T12:30:20+02:00\",\"picto\":\"liv_start\",\"highlight\":true,\"updatedBy\":\"bvittek\",\"stage\":17,\"text\":[\"The final chance for the sprinters? Some still eye a potential opportunity in Granada, on the final day of La Vuelta 26. To earn a final sprint, they would need to survive the climb of the Alhambra, while today’s stage is more straightforward: 185 kilometres of racing on flat roads between Dos Hermanas and Seville, with barely 1,000 metres of elevation gain.<br />\\nThe neutral start is set at 13:00, the start proper at 13:24 after an 11.2 km parade, and the winners should be crowned at around 17:30.\"],\"id\":66850,\"createdBy\":\"bvittek\",\"year\":2026,\"updatedAt\":\"2026-09-09T12:30:20+02:00\",\"publicationAt\":\"2026-09-09T12:30:20+02:00\",\"slug\":\"welcome-to-the-live-coverage-of-stage-17-of-la-vuelta-26\",\"_id\":\"3a4591ecfb5af72c33a1341194f097e729ec24ce02e83c2a6a2b5667422b9744\",\"_bind\":\"publication_en-2026-17\",\"_origin\":\"news-2026-17\",\"_updatedAt\":1788949820310,\"_parent\":\"stage-2026:6656f537dd60fac4d280519087c7c9ce6273a81d92b4d3768af68510b5fe04f3\",\"_key\":\"_id\",\"_refs\":[],\"_virtual\":\"news:welcome-to-the-live-coverage-of-stage-17-of-la-vuelta-26\",\"model\":\"news\"}}"
