      "data": "{\"bind\":\"publication_en-2026-19\",\"app\":\"vue\",\"origin\":\"news-2026-19\",\"change\":\"added\",\"id\":\"f25dbec68de118ba23b2e3d59d61c61a1f09cbf1b7eb0fb7df5c30e61ba26b86\",\"data\":{\"year\":2026,\"type\":\"liv\",\"id\":69935,\"picto\":\"liv_start\",\"updatedAt\":\"2026-09-12T12:00:59+02:00\",\"stageType\":\"VAA\",\"slug\":\"welcome-to-the-live-coverage-of-stage-20-of-la-vuelta-26\",\"createdBy\":\"bvittek\",\"locale\":\"en\",\"updatedBy\":\"bvittek\",\"highlight\":true,\"stage\":19,\"createdAt\":\"2026-09-12T12:00:59+02:00\",\"publicationAt\":\"2026-09-12T12:00:59+02:00\",\"title\":\"Welcome to the live coverage of stage 20 of La Vuelta 26\",\"text\":[\"The final mountain showdown! On the eve of the grand finale in Granada, the peloton face emblematic summits such as the Puerto de El Purche en route to an unprecedented finish. The stage is packed with climbing: 5 categorised ascents (53 KOM points) and almost 5,000 metres of elevation gain between La Calahorra and Collado del Alguacil (186.8 km).<br />\\nThe neutral start is set at 12:30, the start proper at 12:36 after a 1.8 km parade, and the winners should be crowned at around 17:30.\"],\"pinned\":false,\"_id\":\"f25dbec68de118ba23b2e3d59d61c61a1f09cbf1b7eb0fb7df5c30e61ba26b86\",\"_bind\":\"publication_en-2026-19\",\"_origin\":\"news-2026-19\",\"_updatedAt\":1789207259842,\"_parent\":\"stage-2026:047a83daf1879d892051715e205e8ec2fff618c5bf0bc2f912f74af42d1d19c4\",\"_key\":\"_id\",\"_refs\":[],\"_virtual\":\"news:welcome-to-the-live-coverage-of-stage-20-of-la-vuelta-26\",\"model\":\"news\"}}"
